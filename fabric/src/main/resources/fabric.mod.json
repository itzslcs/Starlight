{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Starlight Client: a performance-first HUD and menu client with animated themes. Legit features only.",
  "authors": ["Starlight contributors"],
  "license": "MIT",
  "icon": "assets/starlight/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.starlight.fabric.StarlightFabric"]
  },
  "languageAdapters": {
    "starlight_renderer_switch": "dev.starlight.fabric.RendererSwitch"
  },
  "mixins": ["starlight.mixins.json", "starlight.optional.mixins.json"],
  "depends": {
    "fabricloader": "${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "breaks": {
    "mw19": "*"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  }
}

{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Client-side HUD, GUI, modules and plugins. Legit features only.",
  "authors": ["Kestrel contributors"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.kestrel.fabric.KestrelFabric"]
  },
  "mixins": ["kestrel.mixins.json"],
  "depends": {
    "fabricloader": "${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  }
}
